import * from array_extensions;

// StringRef interface

interface StringRef {
    fn as_ref(obj: Self) -> &String;
}

fn as_ref(obj: String) -> &String {
    return obj.demut();
}

fn as_ref(obj: &String) -> &String {
    return obj;
}

fn as_ref(obj: @String) -> &String {
    return obj.demut();
}

implement StringRef for String;
implement StringRef for &String;
implement StringRef for @String;

// Code point iterator

@doc(
    "Iterator over code points in a String.",
    str: "Reference to the String that is being iterated.",
    pos: "Current UTF-8 position being iterated."
)
class CodePointIterator {
    str: &String;
    pos: Int;
}

fn iterator(it: CodePointIterator) -> CodePointIterator {
    return move(it);
}

fn iterator(it: &CodePointIterator) -> CodePointIterator {
    return *it;
}

fn iterator(it: @CodePointIterator) -> CodePointIterator {
    return *it;
}

fn next(it: @CodePointIterator) -> Int {
    let res = it.str.code_point_at(*it.pos);

    it.pos := it.pos + res.deref().code_point_length();

    return move(res);
}

fn is_consumed(it: @CodePointIterator) -> Bool {
    return it.pos >= it.str.len();
}

implement Iterable<CodePointIterator, Int> for CodePointIterator;
implement Iterable<CodePointIterator, Int> for &CodePointIterator;
implement Iterable<CodePointIterator, Int> for @CodePointIterator;

@doc(
    "Get an iterator over code points.",
    str: "Reference to the String that you want to iterate.",
    "A CodePointIterator over `str`."
)
fn<T> code_points(str: 'T [StringRef]) -> CodePointIterator {
    return CodePointIterator(str.as_ref(), 0);
}

// Algorithms

@doc(
    "Checks whether or not `iter` starts with `start`.",
    iter: "Iterator to check.",
    start: "Start substring to check.",
    "`true` if `iter` starts with `start`, else `false`."
)
fn<T> starts_with(iter: CodePointIterator, start: 'T [StringRef]) -> Bool {
    let start_cp = start.as_ref().code_points();

    for i in move(iter) {
        if start_cp.is_consumed() {
            return true;
        }

        let j = start_cp.next();

        if i != j {
            return false;
        }
    }
    
    return start_cp.is_consumed();
}

@doc(
    "Checks whether or not `str` starts with `start`.",
    str: "String to check.",
    start: "Start substring to check.",
    "`true` if `iter` starts with `start`, else `false`."
)
fn<T, G> starts_with(str: 'T [StringRef], start: 'G [StringRef]) -> Bool {
    return starts_with(str.as_ref().code_points(), start.as_ref());
}

@doc(
    "Checks whether or not `str` contains `haystack`.",
    str: "String to check.",
    haystack: "Substring to check.",
    "`true` if `iter` contains `haystack`, else `false`."
)
fn<T, G> contains(str: 'T [StringRef], haystack: 'G [StringRef]) -> Bool {
    let str_cp = str.as_ref().code_points();

    while !str_cp.is_consumed() {
        if starts_with(*str_cp, haystack.as_ref()) {
            return true;
        }

        str_cp.next();
    }

    return false;
}

@doc(
    "Replace `haystack` in `str` by `rep`. It allocates another String.",
    str: "String to modify.",
    haystack: "Substring to check.",
    rep: "String to use when replacing `haystack`.",
    "The modified string."
)
fn<T, G, K> replace(str: 'T [StringRef], haystack: 'G [StringRef], rep: 'K [StringRef]) -> String {
    let res = arr_with_capacity<Int>(str.as_ref().len());
    let str_cp = str.as_ref().code_points();

    while !str_cp.is_consumed() {
        if starts_with(*str_cp, haystack.as_ref()) {
            for i in haystack.as_ref().code_points() {
                str_cp.next();
            }

            res.push_all(rep.as_ref().utf8_array());

        } else {
            res.push(str_cp.next());
        }
    }

    return utf8_to_str(res);
}

@doc(
    "Breaks `str` into pieces separated by `separator`",
    str: "String to split.",
    separator: "String between each part.",
    "An array with all the parts."
)
fn<T, G> split(str: 'T [StringRef], separator: 'G [StringRef]) -> Array<String> {
    let res = arr<String>();
    let curr_str = arr<Int>();
    let str_cp = str.as_ref().code_points();

    while !str_cp.is_consumed() {
        if starts_with(*str_cp, separator.as_ref()) {
            for i in separator.as_ref().code_points() {
                str_cp.next();
            }

            res.push(utf8_to_str(curr_str));
            curr_str = arr<Int>();

        } else {
            curr_str.push(str_cp.next());
        }
    }

    if curr_str.len() > 0 {
        res.push(utf8_to_str(curr_str)); 
    }

    return move(res);
}

@doc(
    "Parses an string as an Int (base 10). Skips non-numeric characters and does not panic.",
    str: "String to parse.",
    "An integer obtained from `str`."
)
fn<T> parse_int(str: 'T [StringRef]) -> Int {
    let res = 0;
    let str_cp = str.as_ref().code_points();

    for i in str_cp {
        if i >= 48 && i <= 57 {
            res = (res * 10) + (i - 48);
        }
    }

    return move(res);
}

/*
    UNIT TESTS
*/

@test
fn test_cp_iterator() -> Bool {
    let str = "Test";
    let it = str.demut().code_points();
    
    return next(it) == 'T' && next(it) == 'e' &&
           next(it) == 's' && next(it) == 't';
}

@test
fn test_starts_with() -> Bool {
    let str = "Test";
    let it = str.demut().code_points();
    
    return it.deref().starts_with("Te".ref()) &&
           !it.deref().starts_with("st".ref()) &&
           str.demut().starts_with("Te".ref()) &&
           !str.demut().starts_with("st".ref());
}

@test
fn test_contains() -> Bool {
    let str = "This is a test";    
    
    return str.demut().contains("This".ref()) &&
           str.demut().contains("is a".ref()) &&
           !str.demut().contains("not".ref());
}

@test
fn test_replace() -> Bool {
    let str = "This is a test";
    let new = str.demut().replace("test".ref(), "not a test");

    return new == "This is a not a test";
}

@test
fn test_split() -> Bool {
    let str = "This is a test";
    let arr = str.demut().split(" ".ref());

    return arr[0] == "This" && arr[1] == "is" && arr[2] == "a" && arr[3] == "test";
}

@test
fn test_parse_int() -> Bool {
    let str1 = "5631";
    let str2 = "00gd64";

    return str1.demut().parse_int() == 5631 && str2.demut().parse_int() == 64;
}