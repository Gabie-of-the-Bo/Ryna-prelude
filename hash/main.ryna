import * from tuples;
import * from string_extensions;

interface Hashable {
    fn hash(obj: Self) -> Int;
}

fn hash(n: Int) -> Int {
    return *n; // Identity hash
}

fn hash(n: Bool) -> Int {
    if *n {
        return 1;
    }

    return 0;
}

implement Hashable for Int;
implement Hashable for Bool;

// Tuple hashes

fn combine_hashes(a: Int, b: Int) -> Int {
    let res = 17;
    res = res * 31 + a;
    res = res * 31 + b;
    return move(res);
}

fn combine_hashes(a: Int, b: Int, c: Int) -> Int {
    let res = 17;
    res = res * 31 + a;
    res = res * 31 + b;
    res = res * 31 + c;
    return move(res);
}

fn combine_hashes(a: Int, b: Int, c: Int, d: Int) -> Int {
    let res = 17;
    res = res * 31 + a;
    res = res * 31 + b;
    res = res * 31 + c;
    res = res * 31 + d;
    return move(res);
}

fn<T1, T2> hash(obj: ('T1 [Hashable], 'T2 [Hashable])) -> Int {
    return combine_hashes(hash(*obj.get_0()), hash(*obj.get_1()));
}

fn<T1, T2, T3> hash(obj: ('T1 [Hashable], 'T2 [Hashable], 'T3 [Hashable])) -> Int {
    return combine_hashes(hash(*obj.get_0()), hash(*obj.get_1()), hash(*obj.get_2()));
}

fn<T1, T2, T3, T4> hash(obj: ('T1 [Hashable], 'T2 [Hashable], 'T3 [Hashable], 'T4 [Hashable])) -> Int {
    return combine_hashes(hash(*obj.get_0()), hash(*obj.get_1()), hash(*obj.get_2()), hash(*obj.get_3()));
}

implement<T1, T2> Hashable for ('T1 [Hashable], 'T2 [Hashable]);
implement<T1, T2, T3> Hashable for ('T1 [Hashable], 'T2 [Hashable], 'T3 [Hashable]);
implement<T1, T2, T3, T4> Hashable for ('T1 [Hashable], 'T2 [Hashable], 'T3 [Hashable], 'T4 [Hashable]);

// String hash

fn hash(s: String) -> Int {
    let res = 0;

    for c in s.code_points() {
        res = combine_hashes(*res, *c);
    }

    return move(res);
}

implement Hashable for String;