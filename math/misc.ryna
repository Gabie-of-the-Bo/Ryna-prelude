fn<T> min(a: 'T, b: 'T) -> 'T {
    if a < b {
        return cfwd<'T>(a);
    }

    return cfwd<'T>(b);
}

fn<T> max(a: 'T, b: 'T) -> 'T {
    if a < b {
        return cfwd<'T>(b);
    }

    return cfwd<'T>(a);
}

fn droot(n: Int) -> Int {
    if n < 10 {
        return move(n);
    
    } else {
        let res = 0;

        while n > 0 {
            let last_digit = n % 10;
            res = res + last_digit;
            n := n - last_digit;
            n := n / 10;
        }

        return droot(move(res));
    }
}