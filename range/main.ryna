// IntBase interface

interface IntBase {
    fn value(obj: Self) -> Int;
}

fn value(n: Int) -> Int {
    return move(n);
}

fn value(n: &Int) -> Int {
    return *n;
}

fn value(n: @Int) -> Int {
    return *n;
}

implement IntBase for Int;
implement IntBase for &Int;
implement IntBase for @Int;

// Simple range

@doc(
    "Class that represents a lazy range of values.",
    current: "Current integer.",
    end: "Final value to iterate."
)
class Range {
    current: Int;
    end: Int;
}

fn iterator(it: Range) -> Range {
    return *it;
}

fn next(it: @Range) -> Int {
    let curr: @Int = it.current;
    curr.inc();

    return *curr - 1;
}

fn is_consumed(it: @Range) -> Bool {
    return it.current >= it.end;
}

implement Iterable<Range, Int> for Range;

@doc(
    "Returns a range from 0 to `end` (last value not included).",
    end: "Final value to iterate.",
    "The Range value."
)
fn<T> range(end: 'T [IntBase]) -> Range {
    return Range(0, end.value());
}

@doc(
    "Returns a range from `start` to `end` (last value not included).",
    start: "Starting value.",
    end: "Final value to iterate.",
    "The Range value."
)
fn<T, G> range(start: 'T [IntBase], end: 'G [IntBase]) -> Range {
    return Range(start.value(), end.value());
}

@doc(
    "Returns a range from 0 to `end` (last value included).",
    end: "Final value to iterate.",
    "The Range value."
)
fn<T> irange(end: 'T [IntBase]) -> Range {
    return Range(0, end.value() + 1);
}

@doc(
    "Returns a range from `start` to `end` (last value included).",
    start: "Starting value.",
    end: "Final value to iterate.",
    "The Range value."
)
fn<T, G> irange(start: 'T [IntBase], end: 'G [IntBase]) -> Range {
    return Range(start.value(), end.value() + 1);
}

// Skip range

@doc(
    "Class that represents a lazy range of values with a step value.",
    current: "Current integer.",
    end: "Final value to iterate.",
    skip: "Number of values to skip on each iteration."
)
class StepRange {
    current: Int;
    end: Int;
    skip: Int;
}

fn iterator(it: StepRange) -> StepRange {
    return *it;
}

fn next(it: @StepRange) -> Int {
    let curr: @Int = it.current;
    curr := curr + it.skip;

    return *curr - it.skip;
}

fn is_consumed(it: @StepRange) -> Bool {
    if it.skip > 0 {
        return it.current >= it.end;
    }
    
    return it.current <= it.end;
}

implement Iterable<StepRange, Int> for StepRange;

@doc(
    "Returns a range from `start` to `end` (last value included).",
    start: "Starting value.",
    end: "Final value to iterate.",
    step: "Number of values to skip on each iteration.",
    "The Range value."
)
fn<T, G, K> range(start: 'T [IntBase], end: 'G [IntBase], step: 'K [IntBase]) -> StepRange {
    return StepRange(start.value(), end.value(), step.value());
}

@doc(
    "Returns a range from `end` - 1 to 0 (last value included).",
    end: "Inital value to iterate.",
    "The Range value."
)
fn<T> rev_range(end: 'T [IntBase]) -> StepRange {
    return rev_range(0, end.value());
}

@doc(
    "Returns a range from `end` - 1 to `start` (last value included).",
    start: "Starting value.",
    end: "Final value to iterate.",
    "The Range value."
)
fn<T, G> rev_range(start: 'T [IntBase], end: 'G [IntBase]) -> StepRange {
    let _start = start.value() - 1;
    let _end = end.value() - 1;

    return StepRange(move(_end), move(_start), -1);
}

@doc(
    "Returns a range from `start` to `end` (last value included) with a step value.",
    start: "Starting value.",
    end: "Final value to iterate.",
    step: "Number of values to skip on each iteration.",
    "The Range value."
)
fn<T, G, K> irange(start: 'T [IntBase], end: 'G [IntBase], step: 'K [IntBase]) -> StepRange {
    if step.value() > 0 {
        return StepRange(start.value(), end.value() + 1, step.value());
    }

    return StepRange(start.value(), end.value() - 1, step.value());
}

@doc(
    "Returns reversed range.",
    r: "Range to reverse.",
    "The reversed Range value."
)
fn rev(r: Range) -> StepRange {
    return rev_range(move(r.current), move(r.end));
}

/*
    UNIT TESTS
*/

@test
fn range_test_1() -> Bool {
    let sum = 0;

    for i in range(10) {
        sum = sum + i;
    }

    return sum == 45;
}

@test
fn range_test_2() -> Bool {
    let sum = 0;

    for i in range(10, 20) {
        sum = sum + i;
    }

    return sum == 145;
}

@test
fn range_test_3() -> Bool {
    let sum = 0;

    for i in range(0, 20, 2) {
        sum = sum + i;
    }

    return sum == 90;
}

@test
fn irange_test_1() -> Bool {
    let sum = 0;

    for i in irange(10) {
        sum = sum + i;
    }

    return sum == 55;
}

@test
fn irange_test_2() -> Bool {
    let sum = 0;

    for i in irange(10, 20) {
        sum = sum + i;
    }

    return sum == 165;
}

@test
fn irange_test_3() -> Bool {
    let sum = 0;

    for i in irange(0, 20, 2) {
        sum = sum + i;
    }

    return sum == 110;
}

@test
fn rev_range_test_1() -> Bool {
    let sum = 0;

    for i in range(10).rev() {
        sum = sum + i;
    }

    return sum == 45;
}

@test
fn rev_range_test_2() -> Bool {
    let sum = 0;

    for i in range(10, 20).rev() {
        sum = sum + i;
    }

    return sum == 145;
}

@test
fn rev_irange_test_1() -> Bool {
    let sum = 0;

    for i in irange(10).rev() {
        sum = sum + i;
    }

    return sum == 55;
}

@test
fn rev_irange_test_2() -> Bool {
    let sum = 0;

    for i in irange(10, 20).rev() {
        sum = sum + i;
    }

    return sum == 165;
}