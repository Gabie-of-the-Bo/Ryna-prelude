@doc(
    "Print an object and then a newline.",
    obj: "object to print",
    "Nothing."
)
fn<T> println(obj: 'T [Printable]) {
    print(fwd<'T>(obj));
    print("\n");
}

fn<P1, P2> print(o1: 'P1 [Printable], o2: 'P2 [Printable]) {
    print(fwd<'P1>(o1));
    print(fwd<'P2>(o2));
}

fn<P1, P2, P3> print(o1: 'P1 [Printable], o2: 'P2 [Printable], o3: 'P3 [Printable]) {
    print(fwd<'P1>(o1));
    print(fwd<'P2>(o2));
    print(fwd<'P3>(o3));
}

fn<P1, P2, P3, P4> print(o1: 'P1 [Printable], o2: 'P2 [Printable], o3: 'P3 [Printable], o4: 'P4 [Printable]) {
    print(fwd<'P1>(o1));
    print(fwd<'P2>(o2));
    print(fwd<'P3>(o3));
    print(fwd<'P4>(o4));
}

fn<P1, P2, P3, P4, P5> print(o1: 'P1 [Printable], o2: 'P2 [Printable], o3: 'P3 [Printable], o4: 'P4 [Printable], o5: 'P5 [Printable]) {
    print(fwd<'P1>(o1));
    print(fwd<'P2>(o2));
    print(fwd<'P3>(o3));
    print(fwd<'P4>(o4));
    print(fwd<'P5>(o5));
}